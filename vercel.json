{
  "rewrites": [
    {
      "source": "/login",
      "destination": "https://proppio-voice-production.up.railway.app/login.html"
    },
    {
      "source": "/login/",
      "destination": "https://proppio-voice-production.up.railway.app/login.html"
    },
    {
      "source": "/login.html",
      "destination": "https://proppio-voice-production.up.railway.app/login.html"
    },
    {
      "source": "/app",
      "destination": "https://proppio-voice-production.up.railway.app/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "https://proppio-voice-production.up.railway.app/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://proppio-voice-production.up.railway.app/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://proppio-voice-production.up.railway.app/assets/:path*"
    },
    {
      "source": "/panel",
      "destination": "https://proppio-voice-production.up.railway.app/index.html"
    },
    {
      "source": "/:file([^/]+).html",
      "destination": "https://proppio-voice-production.up.railway.app/:file.html"
    }
  ]
}
